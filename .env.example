# ---- App ----
APP_NAME=Budget
# Public URL people use to reach the app (used in email links)
APP_URL=http://localhost:8090
PORT=8090
# Timezone used for transaction dates and month boundaries
TZ=America/Chicago
# Set to false after you create your account to stop strangers registering
ALLOW_SIGNUPS=true

# ---- Bank connection: Teller (free for personal use) ----
# https://teller.io — sign up, copy your Application ID.
TELLER_APP_ID=
# sandbox (fake data, no certificate) | development (real banks, free, 100 logins) | production
TELLER_ENV=development
# For development/production: put certificate.pem + private_key.pem in ./teller
# and keep this line so the mTLS proxy container starts. Remove it for sandbox.
COMPOSE_PROFILES=teller
# Optional override of the API base URL (default: proxy for development/production)
TELLER_API_URL=

# SimpleFIN Bridge (~$15/yr) also works without any config — connect it from the Accounts page.

# ---- PocketBase dashboard superuser (http://host:8090/_/) ----
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-to-a-long-password
# Optional: exactly 32 characters; encrypts stored settings such as the SMTP password
PB_ENCRYPTION_KEY=

# ---- SMTP ----
SMTP_HOST=smtp.example.com
# 587 = STARTTLS (SMTP_TLS=false), 465 = implicit TLS (SMTP_TLS=true)
SMTP_PORT=587
SMTP_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# PLAIN or LOGIN
SMTP_AUTH_METHOD=PLAIN
SMTP_SENDER_ADDRESS=budget@example.com
SMTP_SENDER_NAME=Budget

# ---- Schedules (cron, evaluated in UTC) ----
# Bank sync. SimpleFIN allows ~24 requests/day; keep this at 4-6 runs/day.
SYNC_CRON=0 */6 * * *
# Budget threshold checks
ALERT_CRON=30 * * * *
# Weekly digest email (Monday 14:00 UTC ~ 8am US Central)
DIGEST_CRON=0 14 * * 1
